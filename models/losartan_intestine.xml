      <reaction sboTerm="SBO:0000655" id="LOSABS" name="absorption losartan" reversible="false" compartment="Vapical">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>Import via OATP2B1 at the apical membrane of the enterocytes.
<code>f_OATP2B1</code> is an interaction factor, set by the experiments (no
experiment uses it at the moment).</p>
          </body>
        </notes>
        <listOfReactants>
          <speciesReference species="los_lumen" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="los" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> f_OATP2B1 </ci>
              <ci> LOSABS_k </ci>
              <ci> Vgu </ci>
              <ci> los_lumen </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction sboTerm="SBO:0000655" id="LOSEFL" name="efflux losartan (PG)" reversible="false" compartment="Vapical">
