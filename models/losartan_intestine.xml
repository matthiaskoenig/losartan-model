        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> f_abcb1 </ci>
              <ci> LOSEFL_k </ci>
              <ci> Vgu </ci>
              <ci> los </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
